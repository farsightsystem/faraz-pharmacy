generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String      @map("password_hash")
  role         String      @default("admin")
  createdAt    DateTime    @default(now()) @map("created_at")
  authTokens   AuthToken[]

  @@map("users")
}

model AuthToken {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  accessToken      String   @unique @map("access_token")
  refreshToken     String   @unique @map("refresh_token")
  csrfToken        String   @map("csrf_token")
  accessExpiresAt  DateTime @map("access_expires_at")
  refreshExpiresAt DateTime @map("refresh_expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}

model RecoveryKey {
  id        String    @id @default(uuid())
  keyHash   String    @map("key_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  @@map("recovery_keys")
}

model Product {
  id             String          @id @default(uuid())
  barcode        String          @unique
  name           String
  category       String          @default("")
  location       String
  distributorId  String?         @map("distributor_id")
  salePrice      Float           @default(0) @map("sale_price")
  purchasePrice  Float           @default(0) @map("purchase_price")
  markupPercent  Float           @default(20) @map("markup_percent")
  stockQty       Int             @default(0) @map("stock_qty")
  expiry         String?
  active         Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  companyId      String?         @map("company_id")
  company        Company?        @relation(fields: [companyId], references: [id])
  barcodeLink    Barcode?
  prices         ProductPrice[]
  distributor    Distributor?    @relation(fields: [distributorId], references: [id])
  returnItems    ReturnItem[]
  saleItems      SaleItem[]
  stockPurchases StockPurchase[]
  batches        ProductBatch[]

  @@index([name])
  @@index([location])
  @@index([createdAt])
  @@map("products")
}

model Barcode {
  id        String   @id @default(uuid())
  code      String   @unique
  productId String?  @unique @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product? @relation(fields: [productId], references: [id])

  @@map("barcodes")
}

model ProductPrice {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  label          String          @default("Standard")
  purchasePrice  Float           @default(0) @map("purchase_price")
  salePrice      Float           @default(0) @map("sale_price")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockPurchases StockPurchase[]

  @@map("product_prices")
}

model Distributor {
  id                 String          @id @default(uuid())
  name               String          @default("")
  createdAt          DateTime        @default(now()) @map("created_at")
  deliveryManContact String          @default("") @map("delivery_man_contact")
  deliveryManName    String          @default("") @map("delivery_man_name")
  salesmanContact    String          @default("") @map("salesman_contact")
  salesmanName       String          @default("") @map("salesman_name")
  active             Int             @default(1)
  products           Product[]
  stockPurchases     StockPurchase[]
  batches            ProductBatch[]

  @@map("distributors")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  fatherName  String   @default("") @map("father_name")
  fatherPhone String   @default("") @map("father_phone")
  active      Int      @default(1)
  arrears     Arrear[]
  sales       Sale[]

  @@map("customers")
}

model Sale {
  id         String        @id
  customerId String?       @map("customer_id")
  subtotal   Float         @default(0)
  discount   Float         @default(0)
  tax        Float         @default(0)
  total      Float         @default(0)
  amountPaid Float         @default(0) @map("amount_paid")
  change     Float         @default(0)
  status     String        @default("paid")
  createdAt  DateTime      @default(now()) @map("created_at")
  arrears    Arrear[]
  returns    ReturnEntry[]
  items      SaleItem[]
  customer   Customer?     @relation(fields: [customerId], references: [id])

  @@map("sales")
}

model SaleItem {
  id          String        @id @default(uuid())
  saleId      String        @map("sale_id")
  productId   String        @map("product_id")
  productName String        @map("product_name")
  barcode     String
  quantity    Int           @default(1)
  unitPrice   Float         @default(0) @map("unit_price")
  subtotal    Float         @default(0)
  batchId     String?       @map("batch_id")
  batchNumber String?       @map("batch_number")
  expiry      String?
  product     Product       @relation(fields: [productId], references: [id])
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  batch       ProductBatch? @relation(fields: [batchId], references: [id])

  @@map("sale_items")
}

model Arrear {
  id         String          @id @default(uuid())
  saleId     String?         @map("sale_id")
  customerId String          @map("customer_id")
  totalBill  Float           @default(0) @map("total_bill")
  amountPaid Float           @default(0) @map("amount_paid")
  balanceDue Float           @default(0) @map("balance_due")
  status     String          @default("pending")
  createdAt  DateTime        @default(now()) @map("created_at")
  payments   ArrearPayment[]
  customer   Customer        @relation(fields: [customerId], references: [id])
  sale       Sale?           @relation(fields: [saleId], references: [id])

  @@map("arrears")
}

model ArrearPayment {
  id            String   @id @default(uuid())
  arrearId      String   @map("arrear_id")
  amount        Float    @default(0)
  paymentSaleId String?  @map("payment_sale_id")
  createdAt     DateTime @default(now()) @map("created_at")
  arrear        Arrear   @relation(fields: [arrearId], references: [id], onDelete: Cascade)

  @@map("arrear_payments")
}

model StockPurchase {
  id            String        @id @default(uuid())
  productId     String        @map("product_id")
  distributorId String?       @map("distributor_id")
  invoiceNumber String        @default("") @map("invoice_number")
  quantity      Int           @default(0)
  purchasePrice Float         @default(0) @map("purchase_price")
  salePrice     Float         @default(0) @map("sale_price")
  stax          Float         @default(0) @map("stax")
  expiry        String?
  totalValue    Float         @default(0) @map("total_value")
  active        Int           @default(1)
  batchId       String?       @map("batch_id")
  batchNumber   String        @default("") @map("batch_number")
  priceTierId   String?       @map("price_tier_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  distributor   Distributor?  @relation(fields: [distributorId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  batch         ProductBatch? @relation(fields: [batchId], references: [id])
  priceTier     ProductPrice? @relation(fields: [priceTierId], references: [id])

  @@index([productId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("stock_purchases")
}

model ProductBatch {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  batchNumber    String          @map("batch_number")
  expiryDate     String          @map("expiry_date")
  quantity       Int             @default(0)
  initialQty     Int             @default(0) @map("initial_qty")
  purchasePrice  Float           @default(0) @map("purchase_price")
  salePrice      Float           @default(0) @map("sale_price")
  distributorId  String?         @map("distributor_id")
  invoiceNumber  String?         @map("invoice_number")
  active         Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  distributor    Distributor?    @relation(fields: [distributorId], references: [id])
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems      SaleItem[]
  stockPurchases StockPurchase[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([batchNumber])
  @@map("product_batches")
}

model ReturnEntry {
  id           String       @id @default(uuid())
  saleId       String       @map("sale_id")
  refundAmount Float        @default(0) @map("refund_amount")
  reason       String       @default("")
  createdAt    DateTime     @default(now()) @map("created_at")
  items        ReturnItem[]
  sale         Sale         @relation(fields: [saleId], references: [id])

  @@map("returns")
}

model ReturnItem {
  id           String      @id @default(uuid())
  returnId     String      @map("return_id")
  productId    String      @map("product_id")
  productName  String      @map("product_name")
  quantity     Int         @default(0)
  refundAmount Float       @default(0) @map("refund_amount")
  product      Product     @relation(fields: [productId], references: [id])
  returnEntry  ReturnEntry @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@map("return_items")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Expense {
  id        String   @id @default(uuid())
  title     String
  category  String
  amount    Float    @default(0)
  notes     String   @default("")
  date      String
  active    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@map("companies")
}
