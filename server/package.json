{
  "name": "faraz-pharmacy-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist --clean --dts --sourcemap --external @prisma/client --external @prisma/adapter-pg --external pg",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:reset": "prisma db push --force-reset",
    "db:setup": "npm run db:generate && npm run db:push:reset",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:migrate:name": "prisma migrate dev --name",
    "db:deploy": "prisma migrate deploy",
    "setup": "npm install && npm run db:setup && npm run build",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"*.{ts,js,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"*.{ts,js,cjs,json}\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.0.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.22.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/node-cache": "^4.1.3",
    "prisma": "^7.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
